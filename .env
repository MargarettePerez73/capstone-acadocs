# Backend API URL — points at the XAMPP/PHP backend (acadocs_mobile DB).
# Restart the Expo dev server after changing this.
#
# Leave this commented out and the app auto-picks the right host:
#   - Web / iOS Simulator : http://localhost/acadocsphp/api.php
#   - Android Emulator    : http://10.0.2.2/acadocsphp/api.php
#
# For a PHYSICAL phone (Android or iOS) the device cannot reach
# localhost/10.0.2.2, so set this to your machine's LAN IP, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.50/acadocsphp/api.php
#
# (Both machines must be on the same Wi-Fi, and Windows Firewall must
#  allow inbound connections on port 80 to your XAMPP Apache.)
EXPO_PUBLIC_API_URL=http://192.168.1.46/acadocsphp/api.php
